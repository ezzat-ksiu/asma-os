---
import BrandLayout from '../../layouts/BrandLayout.astro';
import { editions, samples } from '../../content/catalog';
---
<BrandLayout locale="ar" title="فولياڤير — حكايات تُصاغ لتبقى" description="كتب مصممة بعناية انطلاقاً من الحكايات والأفكار التي تختار مشاركتها، وتُراجع قبل الطباعة.">
  <main id="main">
    <section class="fv-container fv-hero"><div><p class="fv-eyebrow">فولياڤير · دار نشر مخصصة</p><h1 class="fv-display">حكاية تستحق أن تبقى بين يديك.</h1><p class="fv-lede">نصمم كتباً مطبوعة بعناية انطلاقاً من الذكريات والأفكار والحكايات التي تختار مشاركتها. تمر كل نسخة بالمراجعة واعتماد النسخة النهائية قبل تجهيزها للطباعة، مع سجل واضح لما تم إنتاجه.</p><div class="fv-actions"><a class="fv-button" href="/ar/editions">اكتشف الإصدارات</a><a class="fv-button-secondary" href="/ar/portfolio">شاهد مجموعة النماذج</a></div><p class="fv-proofline">شارك المعلومات الضرورية للموجز فقط. النشر العام اختياري. صور الأطفال خارج نطاق الفكرة الأولية.</p></div>
      <div class="fv-hero-art" role="img" aria-label="تصميم رقمي توضيحي لغلاف كتاب، وليس صورة لعينة مطبوعة"><span class="fv-orbit" aria-hidden="true"></span><div class="fv-book-mockup"><small>FOLIAVERE · SAMPLE</small><strong>حارسة<br/>مكتبة الضوء</strong><span>نموذج خيالي</span></div><span class="fv-art-caption">تصميم رقمي توضيحي · ليس عينة مصورة</span></div></section>
    <section class="fv-section fv-section-soft"><div class="fv-container"><div class="fv-section-heading"><div><p class="fv-eyebrow">ثلاثة نطاقات محددة</p><h2>اختر مساحة حكايتك.</h2></div><a class="fv-link" href="/ar/editions">قارن الإصدارات ←</a></div><div class="fv-grid">{editions.map(edition => <article class="fv-card"><span class="fv-tag">{edition.pages} صفحة · سعر تخطيطي</span><h3>{edition.name}</h3><p>{edition.arSummary}</p><div class="fv-price">${edition.price}<small> USD · سعر تخطيطي وليس عرضاً للبيع</small></div><a href={`/ar/editions/${edition.id}`}>شاهد النطاق والحدود ←</a></article>)}</div></div></section>
    <section class="fv-section"><div class="fv-container"><div class="fv-section-heading"><div><p class="fv-eyebrow">مجموعة النماذج الأولى</p><h2>ستة كتب خيالية للعرض.</h2></div><a class="fv-link" href="/ar/portfolio">اكتشف النماذج ←</a></div><div class="fv-grid">{samples.slice(0,3).map(sample => <article class="fv-card fv-book-card"><div class="fv-card-inner"><span class="fv-serial">{sample.serial} · نموذج للعرض</span><div><h3>{sample.title}</h3><p>{sample.description}</p><a href={`/vault/${sample.serial}`}>عرض السجل العام ←</a></div></div></article>)}</div><p class="fv-copy">جميع النماذج الستة خيالية ورسومها اصطناعية. وهي للعرض وليست طلبات عملاء أو شهادات شراء.</p></div></section>
    <section class="fv-section fv-section-soft"><div class="fv-container"><div class="fv-section-heading"><div><p class="fv-eyebrow">عملية واضحة</p><h2>توجيه بشري عند كل خطوة مهمة.</h2></div><a class="fv-link" href="/ar/how-it-works">اقرأ تفاصيل العملية ←</a></div><div class="fv-process">{[['٠١','اختر','حدد الجمهور واللغة والنطاق.'],['٠٢','شارك الموجز','أرسل الحقائق الضرورية فقط.'],['٠٣','راجع','تحقق من الأسماء والنص والمعاينة الرقمية.'],['٠٤','اعتمد','تنتظر الطباعة موافقات العميل والمؤسس المطلوبة.']].map(([n,title,copy])=><article><b>{n}</b><h3>{title}</h3><p>{copy}</p></article>)}</div></div></section>
    <section class="fv-container fv-section"><div class="fv-trust-panel"><div><p class="fv-eyebrow">الثقة قبل التقنية</p><h2>الحكايات الشخصية تستحق عناية حقيقية.</h2></div><div><p>لا تقبل الخدمة الأولية صور الأطفال ولا تنشئ قوالب رقمية لوجوههم. النشر في الخزنة العامة اختياري ومحدود بالبيانات التي يوافق العميل على نشرها.</p><a class="fv-button-secondary" href="/ar/trust">اقرأ مركز الثقة</a></div></div></section>
  </main>
</BrandLayout>

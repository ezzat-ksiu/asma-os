---
import BrandLayout from '../../layouts/BrandLayout.astro';
export const prerender = false;
const serial = Astro.params.serial ?? '';
const base = import.meta.env.ASMA_API_BASE_URL;
let record: Record<string, unknown> | null = null;
let issue = 'No approved public record exists for this serial.';
if (base) {
  try {
    const response = await fetch(`${base.replace(/\/$/, '')}/v1/public/vault/${encodeURIComponent(serial)}`, { headers: { accept: 'application/json' } });
    if (response.ok) { record = await response.json(); issue = ''; }
  } catch { issue = 'The public record service is temporarily unavailable.'; }
}
---
<BrandLayout title={`Edition ${serial} | FOLIAVERE`} description="A public edition provenance record, when publication has been explicitly approved." noindex>
  <main id="main" class="fv-container fv-page"><a class="fv-text-link" href="/en">← FOLIAVERE</a><p class="fv-eyebrow" style="margin-block-start:44px">PUBLIC EDITION VAULT</p><h1 class="fv-page-title">Edition {serial}</h1>
    {record ? <section class="fv-card"><div class="fv-card-inner"><h2>Verified public record</h2><p>{String(record.title ?? 'Edition record')}</p><dl><dt>Fingerprint</dt><dd class="fv-serial">{String(record.fingerprint ?? 'Not published')}</dd><dt>Verification status</dt><dd>{String(record.verification_status ?? 'Unspecified')}</dd></dl><h3>Audit certificate</h3><pre class="fv-serial">{JSON.stringify(record.audit_certificate ?? null, null, 2)}</pre></div></section> : <section class="fv-notice"><p>{issue}</p>{!base && <p>Vault records are not configured for this deployment.</p>}</section>}
    <p class="fv-copy">Only records explicitly reviewed and approved for public release can appear here. Portfolio references are fictional examples and do not have production certificates.</p>
  </main>
</BrandLayout>

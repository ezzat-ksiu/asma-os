---
import BrandLayout from '../layouts/BrandLayout.astro';
---
<BrandLayout title="LUMEYRA (لوميرا) — كتب السلالات والذكريات العائلية الفاخرة">
  <h2 style="color: #C7A76C; font-size: 2.2rem; margin-bottom: 15px;">تخليد التراث والتاريخ العائلي في كتب نسلية فاخرة</h2>
  <p style="color: #F5EBDD; font-size: 1.25rem; line-height: 1.9; max-width: 700px; margin: 0 auto 40px auto;">
    تقدم علامة لوميرا أحدث إصدارات الكتب النسلية والمجلدات العائلية المحفورة يدوياً بحبر أرشيفي وجلد طبيعي مقاوم للزمن.
  </p>
  <div style="display: flex; gap: 20px; justify-content: center; flex-wrap: wrap;">
    <div style="border: 1px solid #C7A76C; padding: 25px; border-radius: 8px; background: #343D38; width: 260px;">
      <h3 style="color: #C7A76C; font-size: 1.5rem; margin-top: 0;">طبعة النسل (Heirloom)</h3>
      <p style="color: #F5EBDD; font-size: 0.95rem;">طباعة جلدية فاخرة بحبر أرشيفي مقاوم للزمن</p>
      <div style="color: #C7A76C; font-size: 1.6rem; font-weight: bold; margin-top: 15px;">$199.00 USD</div>
    </div>
    <div style="border: 1px solid #C7A76C; padding: 25px; border-radius: 8px; background: #343D38; width: 260px;">
      <h3 style="color: #C7A76C; font-size: 1.5rem; margin-top: 0;">طبعة المحترف (Atelier)</h3>
      <p style="color: #F5EBDD; font-size: 0.95rem;">تجليد يدوي متقدم مع تطعيم بالذهب وخط عربي أصيل</p>
      <div style="color: #C7A76C; font-size: 1.6rem; font-weight: bold; margin-top: 15px;">$399.00 USD</div>
    </div>
    <div style="border: 1px solid #C7A76C; padding: 25px; border-radius: 8px; background: #343D38; width: 260px;">
      <h3 style="color: #C7A76C; font-size: 1.5rem; margin-top: 0;">طبعة العرش (Grand Atelier)</h3>
      <p style="color: #F5EBDD; font-size: 0.95rem;">صندوق ملكي مخصص وسجل عائلي كامل محفور يدوياً</p>
      <div style="color: #C7A76C; font-size: 1.6rem; font-weight: bold; margin-top: 15px;">$649.00 USD</div>
    </div>
  </div>
</BrandLayout>
---
import BrandLayout from '../../../layouts/BrandLayout.astro';
export const prerender = true;
import { editions } from '../../../content/catalog';
export function getStaticPaths() { return ['en','ar'].flatMap(locale => editions.map(edition => ({ params: { locale, tier: edition.id } }))); }
const { locale, tier } = Astro.params;
const ar = locale === 'ar';
const edition = editions.find((item) => item.id === tier)!;
---
<BrandLayout locale={locale} title={`${edition.name} | FOLIAVERE`} description={ar ? edition.arSummary : edition.summary}>
  <main id="main" class="fv-container fv-page"><p class="fv-eyebrow">{edition.pages} {ar ? 'صفحة' : 'pages'} · {ar ? 'نطاق تخطيطي' : 'planning scope'}</p><h1 class="fv-page-title">{edition.name}: {ar ? edition.arSummary : edition.summary}</h1><div class="fv-price">${edition.price}<small> USD · {ar ? 'سعر تخطيطي، وليس عرضاً للبيع' : 'planning price; not an offer to purchase'}</small></div>
    <div class="fv-prose"><h2>{ar ? 'يشمل النطاق' : 'Scope includes'}</h2><ul>{(ar ? edition.arIncludes : edition.includes).map(item=><li>{item}</li>)}</ul><h2>{ar ? 'الحدود والتأكيدات' : 'Limits and confirmations'}</h2><ul>{(ar ? ['السعر النهائي يتطلب عرض سعر حي حسب الوجهة.', 'لا نقبل صور الأطفال في النسخة الأولية.', 'لا تبدأ الطباعة قبل معاينة العميل وموافقة المؤسس.', 'العلب الصلبة والطباعة المعدنية والنسخ الإضافية تُسعّر منفصلة.'] : ['Final price requires a live destination-specific supplier quote.', 'Child photographs are not accepted in the initial release.', 'Printing waits for customer proof approval and founder approval.', 'Rigid boxes, foil and extra copies are priced separately.']).map(item=><li>{item}</li>)}</ul>
    <div class="fv-notice">{ar ? 'الدفع غير متاح في هذا العرض. لا تُرسل بيانات الدفع أو صوراً أو معلومات شخصية.' : 'Checkout is disabled in this preview. Do not submit payment details, photographs or personal information.'}</div><div class="fv-actions"><a class="fv-button" href={`/${locale}/checkout?edition=${edition.id}`}>{ar ? 'حالة بدء الطلب' : 'Review launch status'}</a><a class="fv-button-secondary" href={`/${locale}/editions`}>{ar ? 'كل الإصدارات' : 'All editions'}</a></div></div>
  </main>
</BrandLayout>

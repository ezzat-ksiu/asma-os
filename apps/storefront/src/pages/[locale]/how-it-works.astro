---
import BrandLayout from '../../layouts/BrandLayout.astro';
export const prerender = true;
export function getStaticPaths() { return [{params:{locale:'en'}},{params:{locale:'ar'}}]; }
const ar = Astro.params.locale === 'ar';
const steps = ar ? [['01','اختر الإصدار','حدد الجمهور واللغة والنطاق. لا ينشئ الأطفال حسابات في الإطلاق الأول.'],['02','شارك موجزاً','قدم الأسماء والحقائق اللازمة فقط، ولا ترفع صور الأطفال.'],['03','راجع التوجه','تُعد المواصفة والمخطط والصفحات التجريبية. تُوقف الحقائق غير المدعومة والمحتويات غير الآمنة.'],['04','اعتمد المعاينة','راجع الأسماء والنص وترتيب الصفحات والرسوم.'],['05','الطباعة والتتبع','لا يُرسل الطلب للمطبعة قبل التحقق من الدفع وعرض المورد وموافقة العميل والمؤسس.'],['06','احتفظ بالسجل','تتوفر شهادة إصدار أو صفحة خزنة اختيارية عند تفعيلها بعد الموافقات.']] : [['01','Choose the edition','Select audience, language and scope. Children do not create accounts in the initial release.'],['02','Share a brief','Provide only the names and facts needed. Do not upload child photographs.'],['03','Review the direction','The specification, outline and sample pages are prepared. Unsupported facts and unsafe content are stopped.'],['04','Approve the proof','Review names, text, page order and selected images.'],['05','Print and track','A verified payment, live supplier quote, customer approval and founder approval are required before dispatch.'],['06','Keep the record','An edition certificate or optional vault page may be available after the required approvals.']];
---
<BrandLayout locale={ar ? 'ar' : 'en'} title={ar ? 'كيف نعمل | فولياڤير' : 'How it works | FOLIAVERE'}>
  <main id="main" class="fv-container fv-page"><p class="fv-eyebrow">{ar ? 'العملية' : 'THE PROCESS'}</p><h1 class="fv-page-title">{ar ? 'من الموجز إلى النسخة المعتمدة.' : 'From brief to an approved edition.'}</h1><div class="fv-prose"><p>{ar ? 'التقنية تساعد في الإنتاج؛ لكنها لا تحل محل مسؤولية الإنسان عن الموافقات المهمة.' : 'Technology can assist production; it does not replace accountable human approval for consequential decisions.'}</p></div><div class="fv-list-cards">{steps.map(([n,title,copy])=><article class="fv-card"><span class="fv-tag">{n}</span><h3>{title}</h3><p>{copy}</p></article>)}</div><p class="fv-notice" style="margin-block-start:24px">{ar ? 'الطلب المدفوع غير متاح حالياً من خلال هذا الموقع. لا تُرسل بيانات شخصية أو مالية.' : 'Paid orders are not currently available through this website. Do not submit personal or financial details.'}</p></main>
</BrandLayout>

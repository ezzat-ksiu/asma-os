---
import BrandLayout from '../../layouts/BrandLayout.astro';
export const prerender = true;
export function getStaticPaths() { return [{params:{locale:'en'}},{params:{locale:'ar'}}]; }
const ar = Astro.params.locale === 'ar';
const requested = Astro.url.searchParams.get('edition');
---
<BrandLayout locale={ar ? 'ar' : 'en'} title={ar ? 'بدء الطلب | فولياڤير' : 'Checkout status | FOLIAVERE'} noindex={true}>
  <main id="main" class="fv-container fv-page"><p class="fv-eyebrow">{ar ? 'حالة الطلب' : 'ORDER STATUS'}</p><h1 class="fv-page-title">{ar ? 'الدفع غير متاح حالياً.' : 'Checkout is not open.'}</h1><div class="fv-prose"><p>{ar ? 'لا توجد بوابة دفع مفعلة في هذه المعاينة. نتحقق أولاً من أهلية البائع، والمراجعة القانونية والضريبية، ومواصفات المورد والتكلفة النهائية قبل قبول أي دفعة.' : 'Payment is disabled in this preview. Seller eligibility, legal and tax review, supplier specifications and landed costs must be confirmed before any payment is accepted.'}</p><p>{requested && <span>{ar ? 'الإصدار المحدد: ' : 'Requested edition: '}<b>{requested}</b></span>}</p><div class="fv-notice">{ar ? 'لا تدخل بيانات بطاقة أو معلومات شخصية هنا. لن يتم إنشاء معاملة مالية.' : 'Do not enter card or personal details here. This page will not create a payment transaction.'}</div><a class="fv-button-secondary" href={ar?'/ar/editions':'/en/editions'}>{ar ? 'العودة للإصدارات' : 'Return to editions'}</a></div></main>
</BrandLayout>

---
import BrandLayout from '../../layouts/BrandLayout.astro';
export const prerender = true;
export function getStaticPaths() { return [{params:{locale:'en'}},{params:{locale:'ar'}}]; }
const ar = Astro.params.locale === 'ar';
---
<BrandLayout locale={ar ? 'ar' : 'en'} title={ar ? 'إصدارات المؤسسات | فولياڤير' : 'Institutional editions | FOLIAVERE'}>
  <main id="main" class="fv-container fv-page"><p class="fv-eyebrow">{ar ? 'الضيافة والتعليم' : 'HOSPITALITY & EDUCATION'}</p><h1 class="fv-page-title">{ar ? 'حوّل المكان إلى حكاية يأخذها الضيف معه.' : 'Turn a place into a story guests can take home.'}</h1><div class="fv-prose">{ar ? <p>تطور فولياڤير كتباً محدودة العدد تقودها هوية المنشأة: قصة المكان والثقافة المحلية والعمارة وطقوس الخدمة وتجربة الضيف. يبدأ أي تعاون بتجربة مدفوعة من خمس نسخ باستخدام محتوى خيالي أو معتمد من المؤسسة.</p> : <p>FOLIAVERE develops short-run, brand-directed books for hospitality teams: property stories, local culture, architecture, service rituals and curated guest experiences. Any engagement begins with a paid five-copy micro-pilot using fictional or institution-approved material.</p>}<h2>{ar ? 'نطاق التجربة' : 'Pilot scope'}</h2><ul>{(ar ? ['خمس نسخ من عنوان واحد.', 'جمهور محدد ولغة معتمدة.', 'دورة معاينة واحدة.', 'عرض حي للطباعة والشحن.', 'تقرير ملاحظات بعد التسليم.'] : ['Five copies of one approved title.', 'One defined audience and approved language.', 'One proof cycle.', 'Live print and shipping quote.', 'Post-delivery feedback summary.']).map(item=><li>{item}</li>)}</ul><div class="fv-notice">{ar ? 'سعر 1,500 دولار نقطة تخطيطية فقط، وليس عرضاً تجارياً. يتطلب أي مقترح نهائي التحقق من نطاق العمل والتكلفة وأهلية البائع وموافقة المؤسس.' : 'USD 1,500 is a planning price only, not a commercial offer. Any final proposal requires verified scope, supplier cost, seller eligibility and founder approval.'}</div><p>{ar ? 'لا توجد شراكات فندقية أو مدرسية قائمة مؤكدة في هذه الصفحة.' : 'This page does not claim an existing hotel or school partnership.'}</p></div></main>
</BrandLayout>

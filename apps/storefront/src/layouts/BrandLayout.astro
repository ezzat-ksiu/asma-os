---
const { title = "LUMEYRA (لوميرا) — كتب السلالات والذكريات العائلية الفاخرة" } = Astro.props;
---
<html lang="ar" dir="rtl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Amiri:ital,wght@0,400;0,700;1,400&family=Marcellus&display=swap" rel="stylesheet">
    <title>{title}</title>
    <style>
      body {
        background-color: #171713;
        color: #F5EBDD;
        font-family: 'Amiri', serif;
        margin: 0;
        padding: 0;
      }
      .header {
        background-color: #343D38;
        padding: 30px;
        text-align: center;
        border-bottom: 2px solid #C7A76C;
      }
      .brand-title {
        color: #C7A76C;
        font-family: 'Marcellus', serif;
        font-size: 3.5rem;
        margin: 0;
        letter-spacing: 4px;
      }
      .container {
        max-width: 900px;
        margin: 40px auto;
        padding: 20px;
        text-align: center;
      }
    </style>
  </head>
  <body>
    <div class="header">
      <h1 class="brand-title">LUMEYRA</h1>
    </div>
    <div class="container">
      <slot />
    </div>
  </body>
</html>